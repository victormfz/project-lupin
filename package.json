{
  "name": "project-lupin",
  "version": "0.1.0",
  "description": "Aplicativo desktop construído com Electron, Node.js e React",
  "main": "src/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "cross-env NODE_ENV=development wait-on tcp:5173 && electron . --dev",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder",
    "build:win": "npm run build:renderer && electron-builder --win",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build:linux": "npm run build:renderer && electron-builder --linux",
    "lint": "eslint src --ext .js,.jsx",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "electron-store": "^9.0.0",
    "electron-updater": "^6.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "build": {
    "appId": "com.seudominio.projectlupin",
    "productName": "Project Lupin",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "src/shared/**/*",
      "src/renderer/dist/**/*",
      "src/renderer/src/assets/img/logo-pqn.png",
      "assets/**/*"
    ],
    "win": {
      "icon": "src/renderer/src/assets/img/logo-pqn.png",
      "target": "nsis"
    },
    "mac": {
      "icon": "src/renderer/src/assets/img/logo-pqn.png",
      "target": "dmg"
    },
    "linux": {
      "icon": "src/renderer/src/assets/img/logo-pqn.png",
      "target": "AppImage"
    }
  }
}
